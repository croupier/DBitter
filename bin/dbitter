#!/usr/bin/env php
<?php

/**
 * DBitter composer-bin wrapper: `vendor/bin/dbitter <action> [--options]`.
 * Looks for the autoloader in two locations — the package installed as a dependency
 * (vendor/croupier/dbitter/bin → three levels up to vendor/autoload.php),
 * and a standalone repository (bin/../vendor/autoload.php). No autoloader at
 * all (standalone without composer install) is not an error: start.php loads
 * lib/bootstrap.php with its own PSR-4-like class autoloader.
 * All argv parsing and dispatching logic lives in start.php — it is shared
 * by both entry points (`php start.php` remains a working entry).
 */

declare(strict_types=1);

foreach ([
    __DIR__ . '/../../../autoload.php', // установлен как зависимость проекта
    __DIR__ . '/../vendor/autoload.php', // standalone-репозиторий DBitter
] as $dbtAutoload) {
    if (is_file($dbtAutoload)) {
        require $dbtAutoload;
        break;
    }
}

require __DIR__ . '/../start.php';
