{
    "name": "dbitter/dbitter",
    "description": "DBitter — universal MySQL migration tool (CLI)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "DbTools\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-all": "phpunit",
        "test-it": "phpunit --testsuite integration",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/phpunit --testsuite unit --coverage-text",
        "test:coverage-html": "@php -d xdebug.mode=coverage vendor/bin/phpunit --testsuite unit --coverage-html coverage",
        "test:coverage-all": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text"
    }
}
