{
    "name": "croupier/dbitter",
    "description": "DBitter — universal MySQL migration CLI tool: export/import dumps, create/drop databases and users, over local/WSL/Docker/SSH/PDO transports",
    "type": "library",
    "license": "MIT",
    "keywords": ["mysql", "migration", "dump", "mysqldump", "cli", "database", "wsl", "docker", "ssh"],
    "require": {
        "php": ">=8.3",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "DbTools\\Lib\\": "lib/",
            "DbTools\\Transport\\": "lib/Transport/",
            "DbTools\\Conf\\": "conf/",
            "DbTools\\Action\\": "actions/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DbTools\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/dbitter"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-all": "phpunit",
        "test-it": "phpunit --testsuite integration",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/phpunit --testsuite unit --coverage-text",
        "test:coverage-html": "@php -d xdebug.mode=coverage vendor/bin/phpunit --testsuite unit --coverage-html coverage",
        "test:coverage-all": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text"
    }
}
